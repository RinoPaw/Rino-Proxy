#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -s /etc/rino-proxy.yaml ] || return 1
    mkdir -p /tmp/rino-proxy
    procd_open_instance
    procd_set_param command /usr/bin/mihomo -d /tmp/rino-proxy -f /etc/rino-proxy.yaml
    procd_set_param file /etc/rino-proxy.yaml
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
